rules_version = '2';
// Правила только для автотестов CRM: любой вошедший может всё.
// Настоящие правила — firestore.rules в корне репозитория (их проверяет набор security).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if request.auth != null; }
  }
}
