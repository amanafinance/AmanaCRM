rules_version = '2';
// Правила доступа Amana CRM (пока база в Firebase).
// Любой вошедший сотрудник работает со всеми данными.
// История действий и корзина только дописываются: исправить или стереть их задним числом нельзя.
// Посторонние (не вошедшие) не видят ничего.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /journal/{id} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
    match /trash/{id} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
    // Остаток счёта не может уйти в минус. Пополнить счёт, который уже в минусе, можно.
    match /wallets/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && request.resource.data.get('balance', 0) >= 0;
      allow update: if signedIn() && (request.resource.data.get('balance', 0) >= -0.004
        || request.resource.data.get('balance', 0) >= resource.data.get('balance', 0));
    }
    match /{collection}/{id} {
      allow read, write: if signedIn() && collection != 'journal' && collection != 'trash' && collection != 'wallets';
    }
  }
}
